{
  "name": "lingxi-pet",
  "productName": "灵犀",
  "version": "0.2.10",
  "private": true,
  "description": "灵犀 (lingxi-pet): an independent desktop companion with configurable character packs, conversational actions, memory, and adapters for existing coding harnesses.",
  "license": "MIT",
  "author": "lingxi-pet contributors",
  "repository": { "type": "git", "url": "https://github.com/18010604027/lingxi.git" },
  "bugs": { "url": "https://github.com/18010604027/lingxi/issues" },
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx core/start.ts",
    "setup:app": "tsx scripts/setup-app.ts",
    "workbench": "electron workbench/main.cjs",
    "test": "vitest run --exclude tests/workarea-bench.test.ts && vitest run tests/workarea-bench.test.ts",
    "typecheck": "tsc --noEmit",
    "test:body": "node --test \"body/test/*.test.cjs\"",
    "test:release": "tsx tests/fixtures/release-smoke.mts",
    "prepare:release": "node scripts/prepare-release.mjs",
    "check:pack": "tsx packs/check.ts",
    "move-data": "node scripts/move-data.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "@langchain/openai": "1.8.0",
    "@microsoft/mxc-sdk": "1.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "lingxi-provider": "workspace:*",
    "express": "^4.22.3",
    "jpeg-js": "0.4.4",
    "koffi": "3.3.1",
    "langchain": "1.6.0",
    "node-screenshots": "0.2.8",
    "onnxruntime-web": "1.30.0",
    "pnpm": "11.28.6",
    "tsx": "^4.23.15",
    "undici": "7.29.1",
    "ws": "^8.21.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "3.1.4",
    "@types/ws": "^8.18.1",
    "electron": "44.4.4",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-textarea-autosize": "^8.5.9",
    "tailwindcss": "^4.3.3",
    "tar-stream": "3.2.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
