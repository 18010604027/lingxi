{
  // Node application, provider adapter, scripts and tests.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["core/**/*.ts", "scripts/**/*.ts", "packages/lingxi-provider/**/*.ts", "packs/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "build", "dist", "vendor"]
}
